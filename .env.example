# Copy to .env.local and fill in what you have.
# None of these are required for the core app — features stay disabled until set.

# AI (bounded semantic search + Q&A with Quran & Hadith citations).
# Any OpenAI-compatible endpoint works — Groq, Gemini, OpenRouter, etc.
# Q&A and discovery only cite verses/hadith found in the bundled datasets.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Roman Urdu data already ships (fawazahmed0/quran-api, Unlicense).
# Only needed if you want to re-fetch from QUL instead: see docs/DATA_SOURCES.md
# QUL_TOKEN=your_token